Include ~/.ssh/config.private

Host github.com
	User git
	IdentityFile ~/.ssh/github-personal

Host bitbucket.org
    User git
    IdentityFile ~/.ssh/bb-work

Host *-o
	Port 22
	User ubuntu
	IdentityFile ~/.ssh/oci-main

Host *
	IdentitiesOnly yes
	AddKeysToAgent yes
	ForwardAgent no
	ConnectTimeout 7
	ServerAliveInterval 120
